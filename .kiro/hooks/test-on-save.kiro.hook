{
  "enabled": true,
  "name": "Run app tests on save",
  "description": "When a Python file in intake/ or autopsy/ is saved, run pytest for that app's tests folder and report failures.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["intake/**/*.py", "autopsy/**/*.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A Python file in intake/ or autopsy/ was just saved. Determine which app it belongs to. Run pytest only for that app's tests folder using the project venv, from the repo root: `.venv/bin/python -m pytest tests/<app> -q` (tests/intake for intake, tests/autopsy for autopsy). If tests/<app> does not exist, say so in one line and do not run anything else. Do not edit any files. Report each failing test with its file, test name and the key assertion or error line. If everything passes, reply with a single line stating the pass count."
  }
}
